  {
   "id": "r1",
   "code": "R1",
   "title": "Brief from Ifeoma Adebayo",
   "kind": "email",
   "from": "Ifeoma Adebayo",
   "to": "You",
   "subject": "Courier partner decision, please set up a meeting this week",
   "blocks": [
    {
     "type": "p",
     "text": "Hi,"
    },
    {
     "type": "p",
     "text": "We need to choose our courier partner for Q1 before the current contract ends on 31 December. I want to decide in a 30 minute online meeting this week with Tunde, Amaka and Kemi."
    },
    {
     "type": "p",
     "text": "Tunde has compared the two options and Amaka holds the Q1 budget. Kemi has the latest complaint figures. Please plan the meeting, send the invitation and papers, run it, and send me the minutes and actions afterwards. You chair and take the minutes."
    },
    {
     "type": "p",
     "text": "I can approve a courier contract within the approved budget line. Anything above it goes to Chinedu."
    },
    {
     "type": "p",
     "text": "We need a decision by Friday 4 December to give 30 days' notice for a 4 January start."
    },
    {
     "type": "p",
     "text": "Thanks,"
    },
    {
     "type": "p",
     "text": "Ifeoma"
    }
   ]
  },
