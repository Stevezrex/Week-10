  {
   "id": "r6",
   "code": "R6",
   "title": "Complaint trend",
   "kind": "memo",
   "from": "Kemi Adeyemi",
   "date": "17 November",
   "blocks": [
    {
     "type": "p",
     "text": "Late delivery complaints were 31% of support tickets in October, up from 22% in September. Most come from Abuja and Port Harcourt orders."
    },
    {
     "type": "p",
     "text": "Customer details are held in the complaint log, which is restricted."
    }
